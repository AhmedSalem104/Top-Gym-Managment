[Unit]
Description=Logic Fit attendance automatic checkout
After=docker.service
Requires=docker.service
ConditionPathExists=@@APP_ROOT@@/bin/logicfit-auto-checkout-job.sh

[Service]
Type=oneshot
ExecStart=@@APP_ROOT@@/bin/logicfit-auto-checkout-job.sh
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
