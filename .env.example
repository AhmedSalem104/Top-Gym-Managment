MSSQL_CONNECTION_STRING="Server=your-server; Database=your-database; User Id=your-user; Password=your-password; Encrypt=True; TrustServerCertificate=False; MultipleActiveResultSets=True"
PORT=3000
# Number of reverse-proxy hops controlled by the deployment. Vercel uses 1;
# keep 0 for direct local development.
TRUST_PROXY_HOPS=1
APP_TIMEZONE=Africa/Cairo
ATTENDANCE_AUTO_CHECKOUT_MINUTES=60
# Required for scheduled backups in production; never use the development fallback there.
CRON_SECRET=replace-with-a-long-random-cron-secret
# Backup storage is disabled by default. Set `local` only for isolated
# local/development/test rehearsals. Production/Staging require an approved
# private provider adapter and must never use the local filesystem.
BACKUP_STORAGE_DRIVER=none
BACKUP_STORAGE_PATH=
# For a production S3-compatible private bucket, use BACKUP_STORAGE_DRIVER=s3
# and set these values in the deployment secret store (never commit them).
BACKUP_STORAGE_ENDPOINT=https://s3.example.com
BACKUP_STORAGE_BUCKET=logic-fit-private
BACKUP_STORAGE_REGION=auto
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
BACKUP_STORAGE_SESSION_TOKEN=
BACKUP_STORAGE_FORCE_PATH_STYLE=true
BACKUP_STORAGE_REQUEST_TIMEOUT_MS=30000
BACKUP_SCHEDULER_CONCURRENCY=2
BACKUP_SCHEDULER_RETRY_COUNT=1
BACKUP_ENABLE_PLATFORM_WEEKLY=true
BACKUP_ENABLE_PLATFORM_MONTHLY=true
# Retention is expressed in days and is bounded by the application.
BACKUP_TENANT_DAILY_RETENTION_DAYS=30
BACKUP_TENANT_MANUAL_RETENTION_DAYS=30
BACKUP_TENANT_PRE_RESTORE_RETENTION_DAYS=30
BACKUP_PLATFORM_DAILY_RETENTION_DAYS=30
BACKUP_PLATFORM_WEEKLY_RETENTION_DAYS=84
BACKUP_PLATFORM_MONTHLY_RETENTION_DAYS=365
BACKUP_PLATFORM_MANUAL_RETENTION_DAYS=30
PUBLIC_APP_URL=https://your-production-domain.example
# Use a long random secret. Production rollout must set this explicitly; plan
# a membership-code reissue/key migration before changing an existing secret.
MEMBERSHIP_CODE_SECRET=replace-with-a-long-random-secret
AUTH_OWNER_EMAIL=owner@example.com
AUTH_OWNER_NAME=TOP GYM Owner
AUTH_OWNER_PASSWORD=replace-with-a-long-random-password
AUTH_SESSION_DAYS=7
AUTH_PLATFORM_ADMIN_EMAIL=platform-admin@example.com
AUTH_PLATFORM_ADMIN_NAME=Platform Admin
AUTH_PLATFORM_ADMIN_PASSWORD=replace-with-a-long-random-platform-password
# Session activity is persisted at most once per session in this interval.
AUTH_SESSION_TOUCH_INTERVAL_MS=60000
# Expiration/scheduled-plan reconciliation runs at most once per tenant/process in this interval.
SAAS_SYNC_INTERVAL_MS=30000
# SQL pool limits apply per Node/Vercel instance; keep defaults until measured.
# Bounded by the application to 1s..300s and 1s..600s respectively.
MSSQL_CONNECTION_TIMEOUT=30000
MSSQL_REQUEST_TIMEOUT=120000
MSSQL_POOL_MAX=10
MSSQL_POOL_MIN=0
MSSQL_POOL_IDLE_TIMEOUT_MS=30000
# Development/Test is enabled with this flag. Production additionally requires
# PERFORMANCE_METRICS_PRODUCTION=true after log-volume/privacy review.
PERFORMANCE_METRICS=false
PERFORMANCE_METRICS_PRODUCTION=false
PLATFORM_ADMIN_HOST=admin.voltyks.app
DEFAULT_TENANT_SLUG=top-gym
# Migration target guard. Keep local for a local SQL Server; staging and
# production require explicit target confirmation (see docs/DEPLOYMENT.md).
MIGRATION_ENV=local
